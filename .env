# Google OAuth Configuration
# Get your credentials from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# API Configuration
# Backend API URL (default: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Application Configuration
NEXT_PUBLIC_APP_NAME=File Converter
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Analytics Configuration
# NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Optional: Sentry Error Tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Keep sensitive data without this prefix to keep them server-side only