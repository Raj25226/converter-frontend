# ============================================================
# unimorpher – Environment Configuration
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Google OAuth ────────────────────────────────────────────
# Get credentials from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ── API / Backend ───────────────────────────────────────────
# URL of your backend API (default: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=unimorpher
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Quota & Limits (all configurable here) ──────────────────
# Daily conversion limit for guests (not logged in)
NEXT_PUBLIC_GUEST_DAILY_LIMIT=5

# Daily conversion limit for logged-in free users
NEXT_PUBLIC_USER_DAILY_LIMIT=15

# Daily conversion limit for Pro/premium users
NEXT_PUBLIC_PRO_DAILY_LIMIT=100

# Maximum file size for guests (in MB)
NEXT_PUBLIC_GUEST_MAX_FILE_SIZE_MB=10

# Maximum file size for logged-in free users (in MB)
NEXT_PUBLIC_USER_MAX_FILE_SIZE_MB=50

# Maximum file size for Pro users (in MB)
NEXT_PUBLIC_PRO_MAX_FILE_SIZE_MB=500

# Auto-delete converted files after N minutes
NEXT_PUBLIC_FILE_EXPIRY_MINUTES=30

# Maximum conversion history records to store per user
NEXT_PUBLIC_MAX_HISTORY_RECORDS=50

# ── Admin ────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
# Users with these emails will automatically get admin role
NEXT_PUBLIC_ADMIN_EMAILS=unimorpher@gmail.com

# ── Monetization ────────────────────────────────────────────
# Google AdSense publisher ID
# NEXT_PUBLIC_ADSENSE_PUB_ID=pub-XXXXXXXXXXXXXXXX

# ── Analytics ───────────────────────────────────────────────
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Error Tracking ──────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ── Feature Flags ───────────────────────────────────────────
# Set to 'true' to enable file virus scanning (requires backend support)
NEXT_PUBLIC_ENABLE_FILE_SCANNING=false

# Set to 'true' to enable Pro plan upsell UI
NEXT_PUBLIC_ENABLE_PRO_PLAN=true

# ── Notes ───────────────────────────────────────────────────
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Keep sensitive keys (database URLs, secret keys) WITHOUT this prefix.
